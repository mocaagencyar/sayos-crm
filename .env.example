# Sayos CRM — Variables de entorno
# Local:  cp .env.example .env  y completá los valores.
# Render: se cargan en el servicio (Environment). NUNCA subas .env a GitHub.

# ── Modo de operación ─────────────────────────────────────
# false = CRM de solo lectura: guarda y muestra las conversaciones, NO responde.
# true  = Max responde automáticamente (requiere ANTHROPIC_API_KEY).
BOT_ENABLED=false

# ── Anthropic (solo si BOT_ENABLED=true) ──────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Proveedor de WhatsApp ──────────────────────────────────
# meta  = API oficial (coexistencia con WhatsApp Business App)
# whapi = vinculación por QR (no oficial), plan B
WHATSAPP_PROVIDER=meta

# ── Meta: coexistencia vía Embedded Signup ────────────────
# App de Meta (Tech Provider) y su configuración de Embedded Signup.
# Prueba actual: app de MC (Max). Producción: app nueva propia.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Token secreto que inventás vos (ej: una frase larga aleatoria). Se usa
# para validar el webhook propio de esta instancia.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# URL pública del servicio en Render (sin barra final). Si queda vacía se
# toma de la request.
PUBLIC_BASE_URL=
# Alternativa manual (sin Embedded Signup): token + phone number ID fijos
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_COEXISTENCE=true

# ── Whapi.cloud (solo si WHATSAPP_PROVIDER=whapi) ─────────
# WHAPI_TOKEN=

# ── Telegram (avisos de mensajes nuevos) — opcional ───────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Marca del dashboard ───────────────────────────────────
BRAND_NAME=Sayos CRM
BRAND_COMPANY=Sayos
BRAND_TAGLINE=Consultas comerciales de WhatsApp
BRAND_SHORT=SY
BRAND_COLOR=#B4A26C
BRAND_COLOR_2=#D8C99A
# Logo: subí assets/logo.png al repo y usá /branding/logo.png, o una URL pública
BRAND_LOGO_URL=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Dashboard privado ────────────────────────────────────
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción (PostgreSQL de Render — nunca SQLite en producción):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Monitor externo (opcional) ───────────────────────────
# MONITOR_SECRET=

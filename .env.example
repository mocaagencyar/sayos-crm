# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=
# Modelo económico recomendado para Max:
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: whapi | meta | twilio
WHATSAPP_PROVIDER=whapi

# ── Whapi.cloud (si WHATSAPP_PROVIDER=whapi) ──────────────
# Obtener en: https://whapi.cloud (plan gratis disponible)
WHAPI_TOKEN=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify
# META_COEXISTENCE=false
# META_APP_ID=1016554401027275
# META_EMBEDDED_SIGNUP_CONFIG_ID=1398042952535570

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Telegram (notificaciones de leads y mensajes nuevos) ──
# Creá un bot con @BotFather y conseguí tu chat_id escribiéndole
# y consultando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Marca del dashboard — white label ─────────────────────
# Sin configurar, el dashboard usa una marca genérica placeholder (no es la
# de ninguna agencia). Completá estas con la marca del cliente final — de
# cualquier agencia que use esta base — y listo, no hace falta tocar código.
# BRAND_NAME=Nombre CRM del cliente
# BRAND_COMPANY=Nombre corto (header)
# BRAND_TAGLINE=Frase corta debajo del nombre
# BRAND_SHORT=XX (2-3 letras para el mark cuando no hay logo)
# BRAND_COLOR=#2563eb
# BRAND_COLOR_2=#60a5fa
# BRAND_LOGO_URL=https://.../logo.png   (o /branding/logo.png si subís assets/logo.png al repo)

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Dashboard privado ────────────────────────────────────
DASHBOARD_USERNAME=mcadmin
DASHBOARD_PASSWORD=cambiar-por-una-clave-segura

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción (PostgreSQL en Supabase, Render u otro proveedor):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Monitor externo ──────────────────────────────────────
# Se usa junto con el workflow de GitHub Actions para alertas por Telegram.
# En Render y GitHub debe tener exactamente el mismo valor secreto.
# MONITOR_SECRET=
